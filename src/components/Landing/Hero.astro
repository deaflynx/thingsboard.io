---
import CtaButton from '@components/Landing/CtaButton.astro';
import SmartImage from '@components/SmartImage.astro';
import type { Cta } from '@models/cta';

interface Props {
	/** Every line but the last is a kicker sitting above the headline. */
	title: string[];
	subtitle: string;
	buttons?: Cta[];
	poster: string;
	video: { webm: string; mp4: string };
}

const { title, subtitle, buttons = [], poster, video } = Astro.props;
---

<section class="hero">
	<div class="hero__content">
		<h1>
			{title.map((line) => (
				<span class="hero__line">{line}</span>
			))}
		</h1>
		<p class="hero__subtitle">{subtitle}</p>

		{buttons.length > 0 && (
			<div class="hero__buttons">
				{buttons.map(({ text, ...button }) => (
					<CtaButton {...button}>{text}</CtaButton>
				))}
			</div>
		)}
	</div>

	<div class="hero__panel" data-video-webm={video.webm} data-video-mp4={video.mp4}>
		{/* Decorative: the panel carried no accessible text as a CSS background either. */}
		<SmartImage
			src={poster}
			alt=""
			width={1920}
			height={924}
			widths={[480, 768, 960, 1280, 1600, 1920]}
			sizes="(min-width: 1024px) 80vw, (min-width: 750px) 50vw, 100vw"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</section>

<style lang="scss">
	@use 'sass:list';
	@use 'sass:math';
	@use 'sass:string';
	@use '../../styles/variables' as *;

	// Black to clear over `$length` on a smootherstep curve.
	// Painted over the footage, not a mask: a mask over a playing video re-composites every frame.
	@function hero-edge-fade($length, $steps: 24) {
		$stops: ();
		@for $i from 0 through $steps {
			$t: math.div($i, $steps);
			$eased: $t * $t * $t * ($t * ($t * 6 - 15) + 10);
			$stops: list.append(
				$stops,
				string.unquote('rgb(0 0 0 / #{math.div(math.round((1 - $eased) * 1000), 10)}%)') ($length * $t),
				comma
			);
		}
		@return linear-gradient(to right, $stops);
	}

	// Source order is the layout — auto-placement gives both arrangements.
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		background-color: #000;
		color: #fff;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: calc(#{$header-height} + 28px) clamp(20px, calc(0.5rem + 2vw), 56px) 36px;

		@include media-down(sm) {
			padding-top: calc(#{$header-height} + 16px);
		}
	}

	h1 {
		@include hero-title;
		margin: 0 0 20px;
	}

	.hero__line {
		display: block;

		// One title line is a headline, not a kicker to nothing.
		&:not(:last-child) {
			color: rgb(255 255 255 / 50%);
		}
	}

	.hero__subtitle {
		@include text-m;
		line-height: 1.5;
		// The mixin colours for a light surface; this one is always black.
		color: #fff;
		max-width: 52ch;
		margin: 0 0 32px;
		text-wrap: pretty;
	}

	.hero__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.hero__panel {
		position: relative;
		background-color: #000;
		filter: saturate(1.2);

		// Not `aspect-ratio`: on a stretched grid item it left the section shorter than its row.
		// Stacked, the footage's own ratio: must match the poster's width and height.
		&::before {
			content: '';
			display: block;
			padding-top: calc(100% * 924 / 1920);
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 1;
			pointer-events: none;
		}

		// Both come from elsewhere — the image from SmartImage, the video from the
		// script below — so neither carries this component's scope attribute.
		:global(img),
		:global(video) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		// The two stack on the same `inset: 0`, and a translucent video no longer covers
		// the poster beneath it — both would show at once.
		&[data-video-playing] :global(img) {
			visibility: hidden;
		}
	}

	h1,
	.hero__subtitle,
	.hero__buttons {
		// `backwards` holds the from-state through the delay, so nothing is parked at 0.
		animation: hero-rise 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) backwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	.hero__subtitle {
		animation-delay: 300ms;
	}

	.hero__buttons {
		animation-delay: 600ms;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
		}
	}

	// Phones: the footage sits behind the copy, in the same grid cell.
	@media (max-width: 599px) {
		.hero__content,
		.hero__panel {
			grid-area: 1 / 1;
		}

		.hero__content {
			position: relative;
			z-index: 1;
		}

		.hero__panel {
			margin-top: $header-height;

			&::before {
				padding-top: 0;
			}

			&::after {
				background-image: linear-gradient(
					to bottom,
					rgb(0 0 0 / 50%),
					rgb(0 0 0 / 62%) 10%,
					rgb(0 0 0 / 78%) 36%,
					rgb(0 0 0 / 80%) 62%,
					rgb(0 0 0 / 85%) 74%,
					rgb(0 0 0 / 90%) 80%,
					rgb(0 0 0 / 90%) 90%,
					#000
				);
			}
		}

		.hero__subtitle {
			text-shadow: 0 0 18px rgb(0 0 0 / 66%);
		}
	}

	// Tablets, and any portrait screen from `md`: the footage under the copy, the copy in two
	// columns — the headline in one, the lede and the actions in the other.
	@media (min-width: 600px) and (max-width: #{$breakpoint-md - 1px}),
		(min-width: $breakpoint-md) and (orientation: portrait) {
		.hero__content {
			--hero-copy-gap: clamp(#{$spacing-6}, 4vw, #{$spacing-8});

			container-type: inline-size;
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto 1fr;
			column-gap: var(--hero-copy-gap);
			align-items: start;
			justify-items: start;
		}

		h1 {
			grid-column: 1;
			grid-row: 1 / -1;
			margin-bottom: 0;
			max-width: 7em;
			// Sized to its column: seven of its own ems fill half the copy.
			font-size: clamp(34px, calc((100cqi - var(--hero-copy-gap)) / 2 / 7), 48px);

			@media (max-height: 620px) {
				font-size: 34px;
			}
		}

		.hero__subtitle,
		.hero__buttons {
			grid-column: 2;
		}

		.hero__subtitle {
			max-width: 34ch;
		}

		.hero__panel {
			// Fills what the copy (~300px) leaves before the fold, the logo strip and 64px of the
			// next section kept in view, but never under 30vw.
			max-height: max(30vw, calc(100svh - var(--promo-h, 0px) - 100px - 64px - 300px));
			overflow: hidden;
		}
	}

	// Side by side, from `md` in landscape: the copy at its natural width, the footage taking the rest.
	@media (min-width: $breakpoint-md) and (orientation: landscape) {
		.hero {
			// The first screen less the promo bar, the header, the ~100px logo strip under the hero and
			// 120px of the section after it, never past the footage's 924. A taller copy sets the row instead.
			--hero-panel-h: min(924px, calc(100svh - var(--promo-h, 0px) - #{$header-height} - 100px - 120px));
			// How far the panel reaches under the copy, so the fade ends just past its widest line.
			--hero-reach: calc(#{$bar-inset} + 16px);
			// At most 2.6 of the panel's height wide, so no more than a fifth of the frame is cut;
			// past that the composition centres in the viewport.
			--hero-panel-col: calc(min(1920px, var(--hero-panel-h) * 2.6) - var(--hero-reach));

			grid-template-columns: minmax(min(22vw, 600px), auto) minmax(0, var(--hero-panel-col));
			justify-content: center;
		}

		.hero__content {
			align-self: center;
			// Above the panel, which reaches under it.
			position: relative;
			z-index: 1;
			padding: calc(#{$header-height} + 28px) $bar-inset 36px;
		}

		h1 {
			max-width: 7em;
			text-wrap: balance;
		}

		.hero__subtitle {
			max-width: 34ch;
		}

		.hero__panel {
			// Grows with a taller text column so `cover` trims instead of leaving a gap.
			align-self: stretch;
			// Clears the bar so nothing plays behind it.
			margin-top: $header-height;
			width: calc(100% + var(--hero-reach));
			margin-left: calc(-1 * var(--hero-reach));
			// The row stretches it past this where the copy is taller, so no black shows under the footage.
			min-height: var(--hero-panel-h);

			&::before {
				padding-top: 0;
			}

			&::after {
				background-image: hero-edge-fade(240px);
			}

			// 2px inside the box, so the fade's edge is the only one on the panel's fractional left pixel:
			// two anti-aliased edges there left a faint column of footage the black did not cover.
			:global(img),
			:global(video) {
				left: 2px;
				width: calc(100% - 2px);
			}
		}
	}

	@media (min-width: 2560px) {
		// 738 = 1920 / 2.6: the panel's widest.
		.hero {
			--hero-panel-h: min(738px, 50svh);
		}

		h1 {
			font-size: clamp(48px, 1.85vw, 64px);
		}

		.hero__subtitle {
			max-width: 44ch;
		}
	}
</style>

<script>
	window.addEventListener('load', () => {
		const panel = document.querySelector<HTMLElement>('.hero__panel');
		if (!panel) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
		if (conn?.saveData) return;
		if (conn?.effectiveType === 'slow-2g' || conn?.effectiveType === '2g') return;

		const { videoWebm, videoMp4 } = panel.dataset;
		if (!videoWebm || !videoMp4) return;

		const video = document.createElement('video');
		video.autoplay = true;
		video.loop = true;
		video.muted = true;
		video.playsInline = true;
		video.setAttribute('aria-hidden', 'true');
		// Marks the panel only once the footage is painting. Appending is too early: the
		// element exists with no frame yet, and hiding the poster then shows black.
		video.addEventListener('playing', () => panel.setAttribute('data-video-playing', ''), { once: true });

		for (const [src, type] of [
			[videoWebm, 'video/webm'],
			[videoMp4, 'video/mp4'],
		]) {
			const source = document.createElement('source');
			source.src = src;
			source.type = type;
			video.appendChild(source);
		}

		panel.appendChild(video);
	});
</script>
